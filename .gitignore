# Working folder with diagnostics and tests - not committed
_work/

# Python
__pycache__/
*.pyc

# Build artefacts (native/build-host.bat, native/build-launcher.bat)
*.obj
native/nvngx.dll
native/nvngx.dll.manifest
native/nvngx.dll_ns-forwarder.dll
native/nvngx.dll_ns-forwarder.exp
native/nvngx.dll_ns-forwarder.lib
native/launcher.res
NeuralScreen.exe
# The FSR bridge's standalone check (tools/build-probe-fsr.bat)
native/probe_fsr.exe
# The state-bookkeeping probe (tools/build-probe-states.bat)
native/probe_states.exe

# NVIDIA redistributable: 165 MB, over the GitHub file limit (100 MB).
# How to get it - see README.md, the Requirements section.
native/nvngx_dlssnr.dll

# The FidelityFX upscaler the AMD runtime follows. AMD's own DLL, and it
# SHIPS in the release archive - see build_release_zip.py. AMD's licence
# grants binary redistribution and names this exact file among the ones
# under its MIT terms (docs/license.md, Kits\FidelityFX\signedbin), so the
# archive may carry it; THIRD-PARTY-NOTICES.md reproduces the notice. Kept
# out of git the same way the NVIDIA runtime is: a build input, not source.
amd_fidelityfx_upscaler_dx12.dll
amd_fidelityfx_loader_dx12.dll
# The AMD runtime and its weights. They SHIP in the release archive (so that
# unpacking it is enough to run), but they are build inputs, not source: kept
# out of git the same way the NVIDIA runtime is. build_release_zip.py lists them
# in its `extra` payload and lets them past the native/ filter by name.
dlssnr_amd_pass1.dll
dlssnr_amd_pass1_patched.dll
dlssnr_on_amd_weights.bin
dlssnr_on_amd.ini
dlssnr_on_amd.log
amdhip64_7.dll

# Optional local Python runtime next to the program
runtime/

# Program log (pythonw launch without a console)
NeuralScreen.log

# Recordings made with Num0
recordings/

# Release archives in the root (rebuilt at release time)
*.zip

# Screenshots taken with the menu button
screenshots/

# Backups left by patch scripts
*.bak-*

# Offscreen renders of the menu, for reviewing the layout
_menu*.png
*.local-backup
release-package.html
# Handoff briefs between sessions: written for one conversation, stale
# the next day. They stay on disk and out of the repository.
BRIEF-*.md

# Dev scripts and personal files - not for the repository
_measure_*.py
_probe_*.py
_render_*.py
_mockup_*.py
test_bake_menu.py
requirements.txt

native/nvngx_dlss.dll

native/nvngx_dlssg.dll

# BYO library folder: user-placed runtime dlls never enter git
native/libraries/*.dll
native/libraries/*.part

# Diagnostic packages built with the menu button: a report is a thing the user
# creates and sends, never something that belongs in the tree.
diagnostics/
